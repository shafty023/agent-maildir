[0.019345, "o", "\u001b[1;36magent-maildir: a real role-routed CLI handoff\u001b[0m\r\n\r\n"]
[2.025732, "o", "\u001b[1;33m$ agent-maildir init\u001b[0m\r\n"]
[2.533598, "o", "{\r\n  \"ok\": true,\r\n  \"version\": 1\r\n}\r\n"]
[4.543621, "o", "\r\n\u001b[1;33m$ agent-maildir register --agent cli-builder --harness other --role builder\u001b[0m\r\n"]
[4.609833, "o", "{\r\n  \"agent\": \"cli-builder\",\r\n  \"ok\": true,\r\n  \"role\": \"builder\"\r\n}\r\n"]
[6.623529, "o", "\r\n\u001b[1;33m$ agent-maildir join --agent cli-reviewer --harness other --role reviewer\u001b[0m\r\n"]
[6.68372, "o", "{\r\n  \"agent\": \"cli-reviewer\",\r\n  \"announced\": [],\r\n  \"attached\": null,\r\n  \"harness\": \"other\",\r\n  \"new\": true,\r\n  \"ok\": true,\r\n  \"push\": \"queued\",\r\n  \"reach\": {\r\n    \"direct\": \"cli-reviewer\",\r\n    \"role_topic\": \"role.reviewer\"\r\n  },\r\n  \"role\": \"reviewer\",\r\n  \"subscribed_now\": [\r\n    \"role.reviewer\"\r\n  ],\r\n  \"topics\": [\r\n    \"role.reviewer\"\r\n  ]\r\n}\r\n"]
[8.805214, "o", "\r\n\u001b[1;35m[reviewer]\u001b[0m blocking in wait for reply to 957abd30-4043-407d-b01c-e76704442b76\r\n\u001b[1;33m$ agent-maildir wait --agent cli-reviewer --reply-to <request-id> --timeout-seconds 20\u001b[0m\r\n"]
[12.80895, "o", "\u001b[2m[reviewer is still blocked]\u001b[0m\r\n"]
[14.813943, "o", "\r\n\u001b[1;34m[builder]\u001b[0m publishing to the role, not an agent id\r\n\u001b[1;33m$ agent-maildir publish --from-agent cli-builder --topic role.reviewer --reply-to <request-id> --subject \"Review ready\"\u001b[0m\r\n"]
[14.878806, "o", "{\r\n  \"ok\": true,\r\n  \"push\": {\r\n    \"cli-reviewer\": \"queued\"\r\n  },\r\n  \"recipients\": [\r\n    \"cli-reviewer\"\r\n  ]\r\n}\r\n"]
[16.912177, "o", "\r\n\u001b[1;35m[reviewer woke; wait returned the real message]\u001b[0m\r\n"]
[16.945621, "o", "{\r\n  \"content\": {\r\n    \"summary\": \"Please inspect release 0.1.1\"\r\n  },\r\n  \"sender\": \"cli-builder\",\r\n  \"subject\": \"Review ready\",\r\n  \"timed_out\": false,\r\n  \"topic\": \"role.reviewer\"\r\n}\r\n"]
[20.951124, "o", "\r\n\u001b[1;32mPASS: role.reviewer delivery woke the blocked CLI wait.\u001b[0m\r\n"]
